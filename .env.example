# Copy this file to .env, replace the placeholder password, and keep .env private.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password

# Grafana listens on the host loopback interface by default. Changing this address
# can make Grafana reachable from other machines.
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
