# Copy this file to .env, replace the placeholder password, and keep .env private.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password

# Stage-0 web interfaces listen on the local host only by default.
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
